{
  "type": "regex/find",
  "category": "正则",
  "title": "正则查找",
  "description": "在文本中用正则表达式查找第一个匹配片段；有捕获组时 match 输出第一个捕获组，否则输出完整匹配。",
  "inputs": [
    {
      "name": "in",
      "type": "exec",
      "cardinality": "1",
      "required": false,
      "kind": "exec",
      "desc": "执行入口：上游执行流到达即执行查找"
    },
    {
      "name": "text",
      "type": "text",
      "cardinality": "1",
      "required": false,
      "kind": "data",
      "desc": "待搜索文本"
    },
    {
      "name": "pattern",
      "type": "text",
      "cardinality": "1",
      "required": false,
      "kind": "data",
      "desc": "Go 正则表达式"
    }
  ],
  "outputs": [
    {
      "name": "found",
      "type": "exec",
      "cardinality": "*",
      "required": false,
      "kind": "exec",
      "desc": "匹配成功时继续"
    },
    {
      "name": "notFound",
      "type": "exec",
      "cardinality": "*",
      "required": false,
      "kind": "exec",
      "desc": "未匹配时继续"
    },
    {
      "name": "ok",
      "type": "bool",
      "cardinality": "*",
      "required": false,
      "kind": "data",
      "desc": "是否匹配成功"
    },
    {
      "name": "match",
      "type": "text",
      "cardinality": "*",
      "required": false,
      "kind": "data",
      "desc": "有捕获组时为第一个捕获组；否则为完整匹配；未匹配时为空"
    }
  ],
  "properties": [
    {
      "name": "text",
      "type": "multiline",
      "default": "",
      "desc": "未连接 text 输入时使用的待搜索文本"
    },
    {
      "name": "pattern",
      "type": "string",
      "default": "",
      "desc": "未连接 pattern 输入时使用的 Go 正则表达式"
    }
  ],
  "order": 52
}
