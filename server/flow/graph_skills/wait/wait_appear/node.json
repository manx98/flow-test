{
  "type": "wait/appear",
  "category": "等待",
  "title": "等出现",
  "description": "等模板在画面中出现：出现走 out 并输出 match，超时走 timeout 分支。可选 mask 忽略模板部分区域。",
  "script": "wait_appear(template, timeout=10, mask=None)",
  "inputs": [
    {
      "name": "in",
      "type": "exec",
      "cardinality": "1",
      "required": true,
      "kind": "exec",
      "desc": "执行入口：上游执行流到达即运行本节点"
    },
    {
      "name": "video",
      "type": "video",
      "cardinality": "1",
      "required": true,
      "kind": "data",
      "desc": "监视的设备画面"
    },
    {
      "name": "template",
      "type": "picture",
      "cardinality": "1",
      "required": true,
      "kind": "data",
      "desc": "要等待出现的模板图片"
    },
    {
      "name": "mask",
      "type": "mask",
      "cardinality": "1",
      "required": false,
      "kind": "data",
      "desc": "可选遮罩：涂抹处不参与匹配"
    }
  ],
  "outputs": [
    {
      "name": "out",
      "type": "exec",
      "cardinality": "1",
      "required": false,
      "kind": "exec",
      "desc": "出现分支：模板出现时走这里"
    },
    {
      "name": "timeout",
      "type": "exec",
      "cardinality": "1",
      "required": false,
      "kind": "exec",
      "desc": "超时分支：超时仍未出现时走这里"
    },
    {
      "name": "match",
      "type": "match",
      "cardinality": "1",
      "required": false,
      "kind": "data",
      "desc": "出现时的命中结果"
    }
  ],
  "properties": [
    {
      "name": "timeout",
      "type": "number",
      "default": 10,
      "desc": "最长等待秒数"
    }
  ],
  "order": 20
}
