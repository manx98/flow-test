{
  "type": "wait/vanish",
  "category": "等待",
  "title": "等消失",
  "description": "等模板从画面中消失：消失走 out，超时仍在走 timeout 分支。可选 mask 忽略模板部分区域。",
  "script": "wait_vanish(template, timeout=10, mask=None)",
  "inputs": [
    {
      "name": "in",
      "type": "exec",
      "cardinality": "1",
      "required": true,
      "kind": "exec",
      "desc": "执行入口：上游执行流到达即运行本节点"
    },
    {
      "name": "video",
      "type": "video",
      "cardinality": "1",
      "required": true,
      "kind": "data",
      "desc": "监视的设备画面"
    },
    {
      "name": "template",
      "type": "picture",
      "cardinality": "1",
      "required": true,
      "kind": "data",
      "desc": "要等待消失的模板图片"
    },
    {
      "name": "mask",
      "type": "mask",
      "cardinality": "1",
      "required": false,
      "kind": "data",
      "desc": "可选遮罩：涂抹处不参与匹配"
    }
  ],
  "outputs": [
    {
      "name": "out",
      "type": "exec",
      "cardinality": "1",
      "required": false,
      "kind": "exec",
      "desc": "消失分支：模板消失时走这里"
    },
    {
      "name": "timeout",
      "type": "exec",
      "cardinality": "1",
      "required": false,
      "kind": "exec",
      "desc": "超时分支：超时仍未消失时走这里"
    }
  ],
  "properties": [
    {
      "name": "timeout",
      "type": "number",
      "default": 10,
      "desc": "最长等待秒数"
    }
  ],
  "order": 21
}
