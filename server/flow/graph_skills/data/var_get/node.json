{
  "type": "var/get",
  "category": "数据",
  "title": "取变量",
  "description": "按 name 取变量值输出。type 可切换输出类型（切换后断开不兼容旧连线）；变量名需与「设变量」端口名一致。",
  "script": "get_var(name, default=None)",
  "inputs": [],
  "outputs": [
    {
      "name": "value",
      "type": "match",
      "cardinality": "*",
      "required": false,
      "kind": "data",
      "desc": "变量值（类型随 type 属性切换）"
    }
  ],
  "properties": [
    {
      "name": "name",
      "type": "string",
      "default": "v",
      "desc": "变量名（与「设变量」端口名一致）"
    },
    {
      "name": "type",
      "type": "enum",
      "default": "match",
      "desc": "输出值类型",
      "options": [
        "match",
        "point",
        "text",
        "number",
        "bool",
        "picture",
        "mask",
        "ocr",
        "device",
        "script"
      ]
    }
  ],
  "order": 37
}
